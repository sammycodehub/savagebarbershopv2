# =============================================================================
# Savage Lifestyle Barber Shop — environment variables
# Copy this file's values in, never commit real secrets to version control.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role key — server-only, never exposed to the browser. Used by
# src/lib/supabase/admin.ts for slot locking and webhook handling.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ----------------------------------------------------------------
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- WhatsApp ------------------------------------------------------------------
# International format, no "+" or spaces, e.g. 233551234567
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=

# --- App -----------------------------------------------------------------------
# Used to build the Paystack callback URL. Set to your deployed URL in
# production (e.g. https://savagelifestylebarbershop.com); localhost for dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
